<core:FragmentDefinition xmlns="sap.m" xmlns:l="sap.ui.layout" xmlns:f="sap.ui.layout.form" xmlns:core="sap.ui.core">
	<VBox class="sapUiSmallMargin">
		<!-- Main Form -->
		<f:SimpleForm id="TransferForm" class="formWithLargeLabels" editable="true" layout="ResponsiveGridLayout" labelSpanXL="4" labelSpanL="5"
			labelSpanM="5" emptySpanXL="0" emptySpanL="0" emptySpanM="0" columnsXL="2" columnsL="2" columnsM="2" columnS="1"
			singleContainerFullSize="false">
			<!-- Employee Details (Left Side) -->
			<core:Title text="Employee Details"/>
			<Label text="Employee" class="customLabelCss"/>
			<Input value="{employeeModel>/Emp}" editable="false"/>
			<Label text="Current SBU-Org. Unit" class="customLabelCss"/>
			<Input value="{employeeModel>/SBU}" editable="false"/>
			<Label text="Current Location-Building"/>
			<Input value="{employeeModel>/Location}" editable="false"/>
			<Label text="Current Designation"/>
			<Input value="{employeeModel>/Designation}" tooltip="{employeeModel>/Designation}" editable="false"/>
			<!-- Manager Details (Right Side) -->
			<core:Title text="Manager Details"/>
			<Label text="Reporting Manager"/>
			<Input value="{employeeModel>/manager}" editable="false"/>
			<Label text="RM's Designation"/>
			<Input value="{employeeModel>/RM_Designation}" tooltip="{employeeModel>/RM_Designation}" editable="false"/>
			<Label text="HOD"/>
			<Input value="{employeeModel>/Hod}" editable="false"/>
			<Label text="HOD Designation"/>
			<Input value="{employeeModel>/Hod1Designation}" editable="false" tooltip="{employeeModel>/Hod1Designation}"/>
		</f:SimpleForm>
		<!-- Transfer Details Section -->
		<HBox justifyContent="Center" class="sapUiMediumMarginTop">
			<VBox width="80%" class="sapUiSmallMargin">
				<f:SimpleForm id="TransferDetailForm" class="formWithLargeLabels" editable="true" layout="ResponsiveGridLayout" labelSpanXL="4"
					labelSpanL="5" labelSpanM="5" emptySpanXL="0" emptySpanL="0" emptySpanM="0" columnsXL="2" columnsL="2" columnsM="2" columnS="1"
					singleContainerFullSize="false">
					<!-- Details (Left Side) -->
					<core:Title text="Transfer Details"/>
					<Label text="New SBU" class="customLabelCss"/>
					<!--<Select items="{newSBUModel>/results}">-->
					<!--	<core:Item key="{newSBUModel>id}" text="{newSBUModel>name}"/>-->
					<!--</Select>-->
					<Select id="newSBUTransfer" items="{newSBUModel>/results}" change="onNewSBUChange" enabled="{stateModel>/isEditable}" forceSelection="false">
						<core:Item key="{newSBUModel>SBUCode}" text="{newSBUModel>SBUDescription} - {newSBUModel>SBUCode}"/>
					</Select>
					<Label text="New Location" class="customLabelCss"/>
					<!--<Input editable="false"/>-->
					<Select id="newLocationTransfer" items="{newLocationModel>/results}" change="onNewLocSelectionChange" enabled="{stateModel>/isEditable}" forceSelection="false">
						<core:Item key="{newLocationModel>LocationId}" text="{newLocationModel>LocationName} - {newLocationModel>LocationId}"/>
					</Select>
					<Label text="New Designation" class="customLabelCss"/>
					<Input id="newDesignationTransfer" value="{empModel>/NewDesignation}" liveChange="onDesignationLiveChange" editable="{stateModel>/isEditable}"/>
					<Label text="New RM" class="customLabelCss"/>
					<Input id="newRMItemsTransfer" placeholder="Select Options" showSuggestion="true" suggestionItems="{newRMModel>/results}"
						liveChange=".newRMSearch" suggestionItemSelected="newRMItmSelected" enabled="{stateModel>/isEditable}">
						<suggestionItems>
							<core:ListItem text="{newRMModel>EmplName} - {newRMModel>EmplId}" additionalText="{newRMModel>EmplId}"/>
						</suggestionItems>
					</Input>
					<!--<Label text=""/>-->
					<!--<CheckBox selected="{empModel>/MatrixManagerSelected}" text="Matrix Manager" select="onMatrixCheck"/>-->
					<!--<Label text="Matrix Manager" class="customLabelCss"/>-->
					<!--<Input value="{empModel>/NewMMId}" enabled="{empModel>/MatrixManagerSelected}"/>-->
					<!--Details (Right Side) -->
					<core:Title text=""/>
					<Label text="New Org Unit" class="customLabelCss"/>
					<!--<Select width="200px" items="{orgModel>/results}">-->
					<!--	<core:Item key="{orgModel>id}" text="{orgModel>name}"/>-->
					<!--</Select>-->
					<Select id="newOrgUnit" items="{newOrgUnitModel>/results}" enabled="{stateModel>/isEditable}" change="onNewOrgUnitChange" forceSelection="false">
						<core:Item key="{newOrgUnitModel>OrgUnit}" text="{newOrgUnitModel>OrgUnitDescription} - {newOrgUnitModel>OrgUnit}"/>
					</Select>
					<Label text="New Building" class="customLabelCss"/>
					<!--<Select width="200px" items="{buildingModel>/results}">-->
					<!--	<core:Item key="{buildingModel>id}" text="{buildingModel>name}"/>-->
					<!--</Select>-->
					<Select id="newBuilding" items="{newBuildingModel>/results}" enabled="{stateModel>/isEditable}" forceSelection="false">
						<core:Item key="{newBuildingModel>BuildingNo}" text="{newBuildingModel>BuildingName} - {newBuildingModel>BuildingNo}"/>
					</Select>
					<Label text=""/>
					<Text text=""/>
					<Label text="New RM Designation" class="customLabelCss"/>
					<Text id="newRm1DesigTransfer" text="{employeeModel>/NewRm1Designation}"/>
				</f:SimpleForm>
				<VBox class="formWithLargeLabels">
					<CheckBox selected="{empModel>/MatrixManagerSelected}" text="Matrix Manager" select="onMatrixCheck" class="sapUiTinyMarginBegin" enabled="{stateModel>/isEditable}"/>
					<f:SimpleForm id="MatrxMngEmpId" class="formWithLargeLabels" editable="true" layout="ResponsiveGridLayout" labelSpanXL="4" labelSpanL="5"
						labelSpanM="5" emptySpanXL="0" emptySpanL="0" emptySpanM="0" columnsXL="2" columnsL="2" columnsM="2" columnS="1"
						singleContainerFullSize="false" visible="false">
						<f:content>
							<Label text="Matrix Manager"/>
							<Input id="matrxMngrEmpIdTransfer" placeholder="Select Manager Id" showSuggestion="true" suggestionItems="{MatrxMngrEmpSetModel>/results}"
								liveChange=".getMatrixManagerSet" suggestionItemSelected="matrxMngrIdSelection" enabled="{stateModel>/isEditable}">
								<suggestionItems>
									<core:ListItem text="{MatrxMngrEmpSetModel>EmplName} - {MatrxMngrEmpSetModel>EmplId}" additionalText="{MatrxMngrEmpSetModel>EmplId}"/>
								</suggestionItems>
							</Input>
							<!-- <core:Title text=""/> -->
							<Label text="Matrix Manager Designation"/>
							<Text id="newMatrxMngrDesigTransfer" text="{employeeModel>/NewMatrixManagerDesig}"/>
							<!--<ComboBox items="" enabled="{empModel>/MatrixManagerSelected}">-->
							<!--	<core:Item key="" text=""/>-->
							<!--</ComboBox>-->
							<!--<Input value="{empModel>/NewMMId}" enabled="{empModel>/MatrixManagerSelected}"/>-->
						</f:content>
					</f:SimpleForm>
				</VBox>
			</VBox>
		</HBox>
	</VBox>
</core:FragmentDefinition>